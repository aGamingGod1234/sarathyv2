{
  "name": "sarathy",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x",
    "npm": "10.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/clean-next-output.js && prisma generate && next build",
    "postbuild": "node scripts/prepare-standalone.js",
    "start": "node scripts/prepare-standalone.js && node .next/standalone/server.js",
    "remotion": "remotion studio src/remotion/index.ts",
    "video:studio": "remotion studio src/remotion/index.ts",
    "video:still": "remotion still src/remotion/index.ts SarathyPromo out/sarathy-promo-frame.png --scale=0.25 --frame=600",
    "video:render": "remotion render src/remotion/index.ts SarathyPromo out/sarathy-promo.mp4 --muted",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "test:security": "node tests/security-controls.test.mjs"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.19.3",
    "@react-three/fiber": "^8.18.0",
    "@shadergradient/react": "^2.4.20",
    "bcryptjs": "^3.0.3",
    "camera-controls": "^3.1.2",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.446.0",
    "next": "15.5.19",
    "next-auth": "^4.24.14",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^2.5.2",
    "three": "^0.185.0",
    "three-stdlib": "^2.36.1"
  },
  "overrides": {
    "next-auth": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.484",
    "@remotion/google-fonts": "^4.0.484",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/three": "^0.185.0",
    "autoprefixer": "^10.0.1",
    "postcss": "^8",
    "prisma": "^6.19.3",
    "remotion": "^4.0.484",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
